@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; font-family: Poppins=
, sans-serif; }

html { scroll-behavior: smooth; }

body { background: rgb(247, 247, 247); color: rgb(51, 51, 51); }

header { position: fixed; width: 100%; top: 0px; left: 0px; background: rgb=
(17, 17, 17); color: rgb(255, 255, 255); display: flex; justify-content: sp=
ace-between; align-items: center; padding: 18px 8%; z-index: 1000; }

.logo { font-size: 30px; color: rgb(255, 183, 3); font-weight: bold; }

nav a { text-decoration: none; color: white; margin-left: 25px; transition:=
 0.3s; }

nav a:hover { color: rgb(255, 183, 3); }

.hero { height: 100vh; background: linear-gradient(rgba(0, 0, 0, 0.6), rgba=
(0, 0, 0, 0.6)), url("https://images.unsplash.com/photo-1517248135467-4c7ed=
cad34c4?w=3D1600") center center / cover; display: flex; justify-content: c=
enter; align-items: center; text-align: center; color: white; }

.hero h1 { font-size: 60px; }

.hero p { margin: 20px 0px; font-size: 22px; }

.btn { display: inline-block; padding: 15px 35px; background: rgb(255, 183,=
 3); color: rgb(17, 17, 17); border-radius: 30px; text-decoration: none; fo=
nt-weight: bold; transition: 0.3s; }

.btn:hover { background: white; }

section { padding: 90px 8%; }

.section-title { text-align: center; font-size: 40px; margin-bottom: 50px; =
}

.menu { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px=
, 1fr)); gap: 30px; }

.card { background: white; border-radius: 15px; overflow: hidden; box-shado=
w: rgba(0, 0, 0, 0.1) 0px 5px 20px; transition: 0.3s; }

.card:hover { transform: translateY(-10px); }

.card img { width: 100%; height: 220px; object-fit: cover; }

.card-content { padding: 20px; }

.price { color: rgb(255, 102, 0); font-size: 22px; font-weight: bold; }

.about { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-it=
ems: center; }

.about img { width: 100%; border-radius: 15px; }

.contact { background: rgb(34, 34, 34); color: white; text-align: center; b=
order-radius: 15px; padding: 60px; }

footer { background: rgb(17, 17, 17); color: white; text-align: center; pad=
ding: 20px; }

@media (max-width: 768px) {
  .hero h1 { font-size: 42px; }
  .about { grid-template-columns: 1fr; }
  header { flex-direction: column; }
  nav { margin-top: 15px; }
}
